# API keys for scripts/vlm_baseline.py. Copy to configs/vlm_keys.env (git-ignored) and fill in.
# A variable already set in the environment wins over this file.

# Claude Opus 5.5: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# GPT-6: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini and Gemini Robotics-ER: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NVIDIA Cosmos (hosted at build.nvidia.com): https://build.nvidia.com (an nvapi-... key)
NVIDIA_API_KEY=
